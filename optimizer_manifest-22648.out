auxiliary_weight_decay_mode = 'adamw_decoupled'

max_iters = 999
decay_lr = True
warmup_iters = 100
lr_decay_iters = 999
min_lr = 6e-5
grad_clip = 1.0

diagnostics_enabled = False
diagnostic_steps = ''
diagnostic_spectral_matrix_names = ''

seed = 1337
device = 'cuda'
dtype = 'bfloat16'
compile = True

